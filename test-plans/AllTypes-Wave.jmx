        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="cardnum:visa" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import com.mockjutsu.jmeter.functions.MockJutsuFinancialFunction;
import org.apache.jmeter.engine.util.CompoundVariable;

fn = vars.getObject(&quot;fn_cardnum_visa&quot;);
if (fn == null) {
    fn = new MockJutsuFinancialFunction();
    java.util.List p = new java.util.ArrayList();
    p.add(new CompoundVariable(&quot;cardnum:visa|TR&quot;));
    fn.setParameters(p);
    vars.putObject(&quot;fn_cardnum_visa&quot;, fn);
}

long t0 = System.nanoTime();
String result = fn.execute(null, null);
long ns = System.nanoTime() - t0;

SampleResult.setResponseData(result, &quot;UTF-8&quot;);
SampleResult.setSuccessful(!result.startsWith(&quot;ERROR&quot;));
SampleResult.setLatency(ns / 1000L);</stringProp>
          <stringProp name="scriptLanguage">beanshell</stringProp>
        </JSR223Sampler>
